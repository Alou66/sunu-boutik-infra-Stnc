.env
.env.*
!.env.example

# Volumes / données locales éventuellement montées en bind
postgres-data/

# Terraform
# Répertoires de travail Terraform, à toute profondeur (modules compris)
.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/**/*.tfvars
!terraform/environments/prod/terraform.tfvars.example
# Plans Terraform : peuvent contenir des valeurs sensibles
*.tfplan
# Les .terraform.lock.hcl sont versionnés (versions et empreintes des providers)

# Ansible
ansible/.vault_pass
ansible/inventory/group_vars/vault/*
!ansible/inventory/group_vars/vault/.gitkeep
*.retry
ansible/inventory/hosts.ini
ansible/inventory/group_vars/all/terraform.yml
ansible/inventory/group_vars/all/vault.yml

# Fichiers locaux et cache Ansible
.ansible/
