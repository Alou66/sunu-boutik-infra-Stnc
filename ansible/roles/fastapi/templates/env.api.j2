DATABASE_URL=postgresql://{{ db_user | urlencode }}:{{ db_password | urlencode }}@{{ database_private_ip }}:{{ postgres_port }}/{{ postgres_db }}
SECRET_KEY={{ secret_key }}
ACCESS_TOKEN_EXPIRE_MINUTES={{ access_token_expire_minutes | default(1440) }}
CORS_ORIGINS={{ cors_origins | default(frontend_url) }}
# SMTP_USER vide = envoi d'emails désactivé côté API (app/core/email.py).
SMTP_HOST={{ smtp_host | default('smtp.gmail.com') }}
SMTP_PORT={{ smtp_port | default(587) }}
SMTP_USER={{ smtp_user | default('') }}
SMTP_PASSWORD={{ smtp_password | default('') if smtp_user | default('') else '' }}
SMTP_SENDER_NAME={{ smtp_sender_name | default('Sunu Boutik') }}
ADMIN_EMAIL={{ admin_email }}
ADMIN_PASSWORD={{ admin_password }}
FRONTEND_URL={{ frontend_url }}
# Uvicorn ne fait confiance à X-Forwarded-For que depuis le Nginx frontend :
# sans cela, slowapi verrait tous les clients avec l'IP du frontend.
FORWARDED_ALLOW_IPS={{ frontend_private_ip }}
