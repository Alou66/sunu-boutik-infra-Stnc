# Copier ce fichier en `.env` puis renseigner de vraies valeurs :
#   cp .env.example .env
#
# `.env` ne doit JAMAIS être commité (voir .gitignore).

# ============================================================
# PostgreSQL (service `db`)
# ============================================================
POSTGRES_USER=sunuboutik
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=sunuboutik
# Port exposé sur la machine hôte (utile pour se connecter avec un client
# SQL type DBeaver/TablePlus depuis l'extérieur des conteneurs).
POSTGRES_PORT=5432

# ============================================================
# Backend — sunu-boutik-api (service `api`)
# ============================================================
API_PORT=8000

# Clé utilisée pour signer les JWT : générer une vraie valeur aléatoire, par
# exemple avec `openssl rand -hex 32`.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origines autorisées en CORS pour l'API (le frontend web ci-dessous).
CORS_ORIGINS=http://localhost:3000

# Envoi d'emails transactionnels via Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Sunu Boutik

# Compte admin plateforme créé automatiquement au premier démarrage de l'API
# s'il n'existe pas déjà (voir app/main.py::_seed_admin).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# URL publique du frontend, utilisée par l'API (ex : liens dans les emails).
FRONTEND_URL=http://localhost:3000

# ============================================================
# Frontend — sunu-boutik-web (service `web`)
# ============================================================
WEB_PORT=3000

# URL de l'API telle qu'appelée depuis le NAVIGATEUR de l'utilisateur (pas
# depuis le réseau interne Docker). Elle est "inlinée" dans le bundle JS au
# moment du build (Next.js), donc toute modification nécessite un rebuild :
#   docker compose up -d --build web
NEXT_PUBLIC_API_URL=http://localhost:8000
